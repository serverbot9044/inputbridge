{
  "manifest_version": 3,
  "name": "InputBridge",
  "short_name": "InputBridge",
  "description": "An independent keyboard and mouse controller layer for Xbox Cloud Gaming.",
  "version": "1.1.0",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://www.xbox.com/*", "https://xbox.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.xbox.com/*", "https://xbox.com/*"],
      "js": ["shared.js", "bridge.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://www.xbox.com/*", "https://xbox.com/*"],
      "js": ["virtual-gamepad.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "InputBridge",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": { "service_worker": "background.js" }
}
